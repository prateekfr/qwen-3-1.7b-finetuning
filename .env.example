# ==============================================================================
# Environment Configuration — Qwen, Minus the E
# ==============================================================================
# Copy this file to .env and fill in your keys if you want to use API-as-a-judge.
# If no keys are provided, the system runs 100% offline using the Local Composite Reward!

# --- OpenRouter Configuration (Recommended for low-cost multi-model access) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI Direct Configuration ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Custom / Local Endpoint (e.g. Local Ollama or vLLM) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
